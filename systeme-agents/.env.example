# --- LM Studio (serveur compatible OpenAI) ---
# Depuis le PC hôte : http://localhost:1234/v1
LLM_BASE_URL=http://localhost:1234/v1
# Identifiant EXACT tel qu'affiché par `python -m agents check` (liste des modèles)
LLM_MODEL=qwen3.6-35b-a3b
LLM_QUANT=Q3 (~15 Go)
# Doit correspondre à la longueur de contexte choisie au chargement dans LM Studio
LLM_CONTEXT=32768
LLM_MAX_TOKENS=2048
LLM_MAX_TOKENS_THINKING=8192
LLM_TEMPERATURE_STRUCTURED=0.2
LLM_TEMPERATURE_THINKING=0.6

# --- Embeddings (petit modèle chargé dans LM Studio) ---
EMBED_MODEL=text-embedding-qwen3-embedding-0.6b
EMBED_DIMS=1024

# --- PostgreSQL (docker compose) --- vide = mode mémoire, sans reprise
DATABASE_URL=postgresql://agents:agents@localhost:5432/agents

# --- SearXNG (docker compose) ---
SEARXNG_URL=http://localhost:8080

# --- Bac à sable : docker (recommandé) ou local (AUCUNE isolation) ---
SANDBOX_MODE=docker
SANDBOX_IMAGE=agents-sandbox:latest
SANDBOX_MEMORY=512m
SANDBOX_TIMEOUT_S=60

# --- Budgets ---
MAX_ITERATIONS=50
MAX_DURATION_MIN=180
MAX_LLM_CALLS=300
MAX_ATTEMPTS=3
